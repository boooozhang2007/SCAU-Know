# 抓取配置示例
# 数据目录（默认 ./data）
# BAUHINIA_DATA_DIR=/var/lib/bauhinia-know

# 触发抓取与后台管理的鉴权令牌
# CRAWL_SECRET=change-me
# ADMIN_SECRET=change-me
# WECHAT_WEBHOOK_SECRET=change-me

# 内置定时抓取调度与前端自动同步默认配置（亦可在 /admin 后台实时修改，持久化至 data/schedule.json）
# AUTO_CRAWL_ENABLED=true
# AUTO_CRAWL_INTERVAL_MINUTES=30
# FRONTEND_SYNC_SECONDS=60

# 微信公众号接入方式：wemp | rss | mp | manual
WECHAT_MODE=wemp

# we-mp-rss 服务配置（wemp 模式）
WEMP_BASE_URL=https://your-wemp-domain
WEMP_USERNAME=admin
WEMP_PASSWORD=change-me

# rss 模式：按账号配置 RSS 地址，键为公众号 id 大写
# WECHAT_RSS_SCAU1909=https://example.com/rss/scau.xml

# mp 模式：公众号后台凭据（会过期，勿提交）
# WECHAT_PASS_TICKET=

# AI 结构化抽取配置（OpenAI 兼容接口）
# AI_API_BASE=https://api.deepseek.com/v1
# AI_API_KEY=
# AI_MODEL=deepseek-chat
# 推理模型（如 minimax-m3.1 系列）可关掉思考省时间/成本，部分上游才认这个字段
# AI_DISABLE_THINKING=1

# 媒体与静态发布配置
# MEDIA_CDN_BASE=
# AUTO_EXPORT_STATIC=false
# CF_PAGES_DEPLOY_HOOK=
# VERCEL_DEPLOY_HOOK=
# GITHUB_REPO=
# GITHUB_TOKEN=

# 附件：只有 IPv6 能到的站点不本地直连，直接留给远端出口机代取（逗号分隔）
# ATTACHMENT_REMOTE_HOSTS=webplus.scau.edu.cn

# 静态发布（pipeline.sh / r2_deploy.py / static-server.mjs 均可被环境变量覆盖）
# APP_DIR=.              项目目录，默认脚本所在目录
# NODE_BIN_DIR=          放 node/tsx 的 bin 目录
# PIPELINE_LOG=          流水线日志路径，默认 $APP_DIR/data/pipeline.log
# R2_BUCKET=             目标桶（S3 兼容）
# R2_OUT=                待上传目录，默认 $APP_DIR/out
# R2_CRED=               凭据 JSON {endpoint,access_key,secret_key[,bucket]}，默认 $APP_DIR/.r2.json
# R2_STATE=              增量状态，默认 $APP_DIR/data/r2-state.json
# CF_PURGE_SCRIPT=       部署后清 Cloudflare 缓存的脚本路径，留空则跳过
# FRP_DEPLOY_SCRIPT=     FRP_DEPLOY=1 时同步的回滚副本脚本
# PAGES_PROJECT=         PAGES_DEPLOY=1 时的 Pages 项目名
# NOTICES_PATH=          采集库路径，默认 ./data/notices.json
