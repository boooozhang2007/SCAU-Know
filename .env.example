# 抓取配置示例
# 数据目录（默认 ./data）
# BAUHINIA_DATA_DIR=/var/lib/bauhinia-know

# 触发抓取与后台管理的鉴权令牌
# CRAWL_SECRET=change-me
# ADMIN_SECRET=change-me
# WECHAT_WEBHOOK_SECRET=change-me

# 内置定时抓取调度与前端自动同步默认配置（亦可在 /admin 后台实时修改，持久化至 data/schedule.json）
# AUTO_CRAWL_ENABLED=true
# AUTO_CRAWL_INTERVAL_MINUTES=30
# FRONTEND_SYNC_SECONDS=60

# 微信公众号接入方式：wemp | rss | mp | manual
WECHAT_MODE=wemp

# we-mp-rss 服务配置（wemp 模式）
WEMP_BASE_URL=https://your-wemp-domain
WEMP_USERNAME=admin
WEMP_PASSWORD=change-me

# rss 模式：按账号配置 RSS 地址，键为公众号 id 大写
# WECHAT_RSS_SCAU1909=https://example.com/rss/scau.xml

# mp 模式：公众号后台凭据（会过期，勿提交）
# WECHAT_PASS_TICKET=

# AI 结构化抽取配置（OpenAI 兼容接口）
# AI_API_BASE=https://api.deepseek.com/v1
# AI_API_KEY=
# AI_MODEL=deepseek-chat

# 媒体与静态发布配置
# MEDIA_CDN_BASE=
# AUTO_EXPORT_STATIC=false
# CF_PAGES_DEPLOY_HOOK=
# VERCEL_DEPLOY_HOOK=
# GITHUB_REPO=
# GITHUB_TOKEN=
